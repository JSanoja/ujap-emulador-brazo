{
  "name": "@emulador/emulator",
  "version": "0.1.0",
  "private": true,
  "description": "Emulador 3D (Babylon.js) para web y Android (Capacitor).",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "android:sync": "vite build && cap sync android",
    "e2e": "vite build && node e2e/run.ts",
    "e2e:device": "node e2e/device.ts",
    "android": "node scripts/android.ts",
    "icons": "cmd.exe /c node scripts/render-icons.ts"
  },
  "dependencies": {
    "@babylonjs/core": "^9.27.1",
    "@babylonjs/loaders": "^9.27.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.2",
    "@emulador/core": "*"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "vite-plugin-pwa": "^1.3.0"
  }
}
